COMPANY_SEARCH_DATABASE_URL=postgresql+psycopg://company_search:company_search@127.0.0.1:54329/company_search
COMPANY_SEARCH_LIBRARY_ROOT=/Users/your-name/Library/Application Support/CompanySearch
COMPANY_SEARCH_BIND_HOST=127.0.0.1
COMPANY_SEARCH_BIND_PORT=8000
COMPANY_SEARCH_OLLAMA_BASE_URL=http://127.0.0.1:11434
COMPANY_SEARCH_OLLAMA_MODEL=qwen3:8b
# 快速问答模式使用 5m（回答后模型驻留 5 分钟）；改为 0 切换为节省内存模式（回答后立即释放模型）。
COMPANY_SEARCH_OLLAMA_KEEP_ALIVE=5m
COMPANY_SEARCH_DEEPSEEK_BASE_URL=https://api.deepseek.com
COMPANY_SEARCH_DEEPSEEK_MODEL=deepseek-chat
COMPANY_SEARCH_DEEPSEEK_API_KEY=
COMPANY_SEARCH_RAG_SOURCE_LIMIT=6
COMPANY_SEARCH_RAG_HISTORY_TURNS=6
COMPANY_SEARCH_BATCH_MAX_FILES=1000
COMPANY_SEARCH_BATCH_MAX_TOTAL_BYTES=10737418240
COMPANY_SEARCH_BATCH_MIN_FREE_BYTES=5368709120
# 公司同义词组使用分号分组、竖线分隔同义词。
COMPANY_SEARCH_SEARCH_SYNONYMS=k8s|kubernetes|容器编排;气泡项目|气泡检测|bubble;日报|工作记录|周报
COMPANY_SEARCH_SEARCH_MIN_EVIDENCE_SCORE=0.35
COMPANY_SEARCH_SEARCH_PER_DOCUMENT_LIMIT=3
# 默认关闭，不下载也不加载额外精排模型；需要时改为 true 后重新运行 setup.sh。
COMPANY_SEARCH_RERANK_ENABLED=false
COMPANY_SEARCH_RERANK_MODEL=BAAI/bge-reranker-v2-m3
COMPANY_SEARCH_RERANK_CANDIDATE_LIMIT=20
# 默认留空即关闭 Harness；只填写明确允许操作的 Kubernetes context。
COMPANY_SEARCH_K8S_ALLOWED_CONTEXTS=
COMPANY_SEARCH_HARNESS_MAX_STEPS=8
COMPANY_SEARCH_HARNESS_TIMEOUT_SECONDS=300
COMPANY_SEARCH_HARNESS_APPROVAL_MINUTES=10
COMPANY_SEARCH_HARNESS_AUDIT_DAYS=30
# 相同问题命中内存回答缓存（资料版本变化自动失效）
COMPANY_SEARCH_ANSWER_CACHE_ENABLED=true
# 首次启动自动创建的管理员账号密码（默认 admin/admin123，请上线前修改）
COMPANY_SEARCH_ADMIN_PASSWORD=admin123
